pkg_check_modules(TEAM REQUIRED IMPORTED_TARGET team-application>=1.3.6)
pkg_check_modules(APP_CORE REQUIRED IMPORTED_TARGET app-core-cpp)
include(CheckCXXSourceCompiles)
set(CMAKE_REQUIRED_INCLUDES ${APP_CORE_INCLUDE_DIRS})
set(CMAKE_REQUIRED_LIBRARIES PkgConfig::APP_CORE)
check_cxx_source_compiles("#include <app_core_base.h>\nint main() { return app_core_locale_manager_set_language(\"en_US.UTF-8\"); }"
  BUXBY_HAS_APP_CORE_LOCALE_API)
unset(CMAKE_REQUIRED_INCLUDES)
unset(CMAKE_REQUIRED_LIBRARIES)
if(NOT BUXBY_HAS_APP_CORE_LOCALE_API)
  message(FATAL_ERROR "The selected platform SDK must provide app_core_base.h and app_core_locale_manager_set_language. No internal-header fallback is used.")
endif()
foreach(member main day activity)
  add_library(dali-buxby-${member} SHARED src/${member}-member.cpp)
  target_link_libraries(dali-buxby-${member} PRIVATE buxby-${member}-scene PkgConfig::TEAM)
  target_compile_options(dali-buxby-${member} PRIVATE -Wall -Wextra -fvisibility=hidden)
  target_link_options(dali-buxby-${member} PRIVATE -Wl,-z,defs)
  if(member STREQUAL "main")
    target_link_libraries(dali-buxby-${member} PRIVATE PkgConfig::APP_CORE)
  endif()
  install(TARGETS dali-buxby-${member} LIBRARY DESTINATION bin)
endforeach()
